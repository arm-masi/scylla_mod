<?xml version="1.0" encoding="UTF-8"?>
<bsim:definitions xmlns:bsim="http://bsim.hpi.uni-potsdam.de/scylla/simModel"
                  targetNamespace="http://www.hpi.de">

  <bsim:simulationConfiguration id="clientserver-config"
                                processRef="clientserver"
                                processInstances="50"
                                startDateTime="2025-01-01T00:00:00+01:00[Europe/Rome]"
                                randomSeed="123">

    <bsim:resources>
      <bsim:resourceType id="client" defaultTimetableId="default">
        <bsim:resource id="client" cost="2000" ram="4096" ioRead="300" ioWrite="200" txSpeed="15" rxSpeed="10"/>
      </bsim:resourceType>

      <bsim:resourceType id="server" defaultTimetableId="default">
        <bsim:resource id="server" cost="4000" ram="8192" ioRead="800" ioWrite="600" txSpeed="100" rxSpeed="100"/>
      </bsim:resourceType>
    </bsim:resources>

    <bsim:timing>
      <bsim:timetable id="default">
        <bsim:available from="00:00" to="23:59"/>
      </bsim:timetable>
    </bsim:timing>

    <bsim:startEvent id="StartEvent_1">
      <bsim:arrivalRate timeUnit="SECONDS">
        <bsim:exponentialDistribution>
          <bsim:mean>1.0</bsim:mean>
        </bsim:exponentialDistribution>
      </bsim:arrivalRate>
    </bsim:startEvent>

    <bsim:Task id="Client_HTTP_Request">
      <bsim:plugin>resourceCost</bsim:plugin>
      <bsim:resources>
        <bsim:resource id="client" amount="1"/>
      </bsim:resources>
      <bsim:attribute key="numInstructions" value="2000"/>
      <bsim:attribute key="ram" value="20"/>
      <bsim:attribute key="readOps" value="10"/>
      <bsim:attribute key="writeOps" value="5"/>
      <bsim:attribute key="txMB" value="1"/>
      <bsim:attribute key="rxMB" value="1"/>
    </bsim:Task>

    <bsim:Task id="Client_IMG_Request">
      <bsim:plugin>resourceCost</bsim:plugin>
      <bsim:resources>
        <bsim:resource id="client" amount="1"/>
      </bsim:resources>
      <bsim:attribute key="numInstructions" value="4000"/>
      <bsim:attribute key="ram" value="50"/>
      <bsim:attribute key="readOps" value="20"/>
      <bsim:attribute key="writeOps" value="10"/>
      <bsim:attribute key="txMB" value="5"/>
      <bsim:attribute key="rxMB" value="2"/>
    </bsim:Task>

    <bsim:Task id="Server_Send_HTML">
      <bsim:plugin>resourceCost</bsim:plugin>
      <bsim:resources>
        <bsim:resource id="server" amount="1"/>
      </bsim:resources>
      <bsim:attribute key="numInstructions" value="3000"/>
      <bsim:attribute key="ram" value="30"/>
      <bsim:attribute key="readOps" value="30"/>
      <bsim:attribute key="writeOps" value="10"/>
      <bsim:attribute key="txMB" value="2"/>
      <bsim:attribute key="rxMB" value="1"/>
    </bsim:Task>

    <bsim:Task id="Server_Send_IMG">
      <bsim:plugin>resourceCost</bsim:plugin>
      <bsim:resources>
        <bsim:resource id="server" amount="1"/>
      </bsim:resources>
      <bsim:attribute key="numInstructions" value="8000"/>
      <bsim:attribute key="ram" value="100"/>
      <bsim:attribute key="readOps" value="60"/>
      <bsim:attribute key="writeOps" value="20"/>
      <bsim:attribute key="txMB" value="8"/>
      <bsim:attribute key="rxMB" value="3"/>
    </bsim:Task>

    <bsim:Task id="Client_Process_Response">
      <bsim:plugin>resourceCost</bsim:plugin>
      <bsim:resources>
        <bsim:resource id="client" amount="1"/>
      </bsim:resources>
      <bsim:attribute key="numInstructions" value="1000"/>
      <bsim:attribute key="ram" value="10"/>
      <bsim:attribute key="readOps" value="5"/>
      <bsim:attribute key="writeOps" value="5"/>
      <bsim:attribute key="txMB" value="0.5"/>
      <bsim:attribute key="rxMB" value="0.5"/>
    </bsim:Task>

  </bsim:simulationConfiguration>
</bsim:definitions>
