<?xml version="1.0" encoding="UTF-8"?>
<bsim:globalConfiguration xmlns:bsim="http://bsim.hpi.uni-potsdam.de/scylla/simModel"
                          targetNamespace="http://www.hpi.de"
                          id="clientserver-global">

  <bsim:resourceData>
    <bsim:dynamicResource id="client" defaultQuantity="50" defaultCost="2000.0" defaultTimeUnit="SECONDS">
      <bsim:instance name="client"
                     cpuSpeed="2000"
                     ram="4096"
                     ioRead="300"
                     ioWrite="200"
                     txSpeed="15"
                     rxSpeed="10"/>
    </bsim:dynamicResource>

    <bsim:dynamicResource id="server" defaultQuantity="1" defaultCost="4000.0" defaultTimeUnit="SECONDS">
      <bsim:instance name="server"
                     cpuSpeed="4000"
                     ram="8192"
                     ioRead="800"
                     ioWrite="600"
                     txSpeed="100"
                     rxSpeed="100"/>
    </bsim:dynamicResource>
  </bsim:resourceData>

  <bsim:zoneOffset>+01:00</bsim:zoneOffset>

  <bsim:timetables>
    <bsim:timetable id="t1">
      <bsim:timetableItem from="MONDAY" to="SUNDAY" beginTime="00:00" endTime="23:59:59"/>
    </bsim:timetable>
  </bsim:timetables>

  <bsim:randomSeed>42</bsim:randomSeed>
</bsim:globalConfiguration>
